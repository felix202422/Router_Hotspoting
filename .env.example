# ============================================================================
# Environment template — copy to `.env` (git-ignored) and fill in real values.
# NEVER commit real secrets (master rule 6).
# ============================================================================

# --- PostgreSQL (backend) ---
DB_URL=jdbc:postgresql://localhost:5432/hotspot
DB_USER=hotspot
DB_PASSWORD=change-me

# --- Admin bootstrap (created only when administrators table is empty) ---
ADMIN_EMAIL=admin@hotspot.co.tz
ADMIN_PASSWORD=change-me

# --- JWT signing secret (openssl rand -base64 48) ---
JWT_SECRET=change-me-generate-a-long-random-string

# --- Provider selection: mock (local dev) | daraja / africastalking (Phase 5) ---
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
HOTSPOT_CONTROLLER=mock

# --- Phase 5: M-Pesa Daraja sandbox ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_WEBHOOK_SECRET=

# --- Phase 5: Africa's Talking ---
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# --- Phase 5: MikroTik ---
MIKROTIK_HOST=
MIKROTIK_PORT=8729
MIKROTIK_USER=
MIKROTIK_PASSWORD=

# --- Frontend (Vite) ---
# VITE_API_MODE=live
